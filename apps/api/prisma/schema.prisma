generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentProvider {
  PAYOS
  STRIPE
}

enum CouponType {
  PERCENT
  FIXED
}

enum TicketStatus {
  OPEN
  REPLIED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
}

enum PostType {
  BLOG
  PAGE
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

enum ReviewStatus {
  PENDING
  APPROVED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  role         Role     @default(CUSTOMER)
  isActive     Boolean  @default(true) // khóa/mở tài khoản (CRM Phase 3)
  emailVerifiedAt DateTime?
  image        String?
  resetToken   String?
  resetExpires DateTime?
  verificationToken   String?
  verificationExpires DateTime?
  createdAt    DateTime @default(now())
  orders       Order[]
  licenses     License[]
  reviews      Review[]
  tickets      Ticket[]             // ticket do user này gửi
  assignedTickets Ticket[] @relation("TicketAssignee") // ticket được gán cho user này (STAFF/ADMIN)
  posts        Post[]              // bài viết do user này viết (CMS Phase 3)
  // --- Phase 4: Custom Service ---
  customRequests   CustomProjectRequest[]        // yêu cầu báo giá do user gửi
  customerProjects CustomProject[]       @relation("CustomerProject") // dự án là khách hàng
  assignedProjects CustomProject[]       @relation("ProjectAssignee")  // dự án được gán (STAFF/ADMIN)
  projectMessages  ProjectMessage[]               // tin nhắn đã gửi trong dự án
  projectFiles     ProjectFile[]                  // file đã upload trong dự án
  payments         Payment[]                      // lịch sử thanh toán (Phase 1 Order + Phase 4 Milestone)
}

model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  products  Product[]
  posts     Post[]    // bài CMS thuộc danh mục này (Phase 3)
}

model Product {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  description String
  price       Int       // đơn vị VND (không dùng số thập phân)
  thumbnail   String?
  fileKey     String?   // key trên R2
  images      String[]  @default([]) // gallery (Phase 2)
  docs        Json?                     // tài liệu: [{title,url}]
  changelog   Json?                     // changelog: [{version,date,notes}]
  demoUrl     String?                   // link demo
  language    String?                   // ngôn ngữ (filter search Phase 2)
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id])
  isPublished Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  orderItems  OrderItem[]
  tiers       LicenseTier[]
  licenses    License[]
  reviews     Review[]
}

model Order {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id])
  status    OrderStatus    @default(PENDING)
  total     Int
  provider  PaymentProvider
  providerRef String?      // order code từ cổng TT
  items     OrderItem[]
  licenses  License[]      // 1 đơn có nhiều license (1/item, Phase 2)
  couponCode String?       // mã giảm giá áp dụng (Phase 2)
  createdAt DateTime       @default(now())
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  price         Int
  qty           Int     @default(1)
  licenseTierId String?  // gói license đã chọn (Phase 2)
  tierName      String?  // snapshot tên gói tại thời điểm mua
}

model License {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  orderId   String   // quan hệ cha (1 đơn có nhiều license)
  order     Order    @relation(fields: [orderId], references: [id])
  orderItemId String @unique // 1 license / 1 item (Phase 2; breaking từ orderId @unique)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  licenseTierId String?      // gói license (Phase 2)
  tier      LicenseTier? @relation(fields: [licenseTierId], references: [id])
  key       String   @unique
  downloadCount  Int  @default(0)
  downloadLimit  Int  @default(5)  // giới hạn tải (Phase 2)
  downloadResetAt DateTime @default(now()) // mốc reset định kỳ 1 tháng
  createdAt DateTime @default(now())
}

// --- Review & Rating (2.3) ---
model Review {
  id        String       @id @default(cuid())
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int          // 1-5
  comment   String?
  status    ReviewStatus @default(PENDING) // chờ admin duyệt
  createdAt DateTime     @default(now())
  @@unique([productId, userId])   // 1 user 1 review/sản phẩm
  @@index([productId])
  @@index([status])
}

// --- Multi-license (2.6) ---
model LicenseTier {
  id          String  @id @default(cuid())
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  licenses    License[]         // các license đã mua gói này
  name        String            // "Regular" | "Extended"
  slug        String            // unique trong product
  price       Int               // VND, server-authoritative
  description String?
  features    String[]          // quyền lợi gói
  sortOrder   Int     @default(0)
  createdAt   DateTime @default(now())
  @@unique([productId, slug])
}

// --- Coupon (2.5) ---
model Coupon {
  id          String      @id @default(cuid())
  code        String      @unique
  type        CouponType
  value       Int         // % (0-100) hoặc VND
  minOrder    Int?        // điều kiện tối thiểu
  maxDiscount Int?        // trần giảm cho PERCENT
  expiresAt   DateTime?
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
}

// --- Support Ticket (2.4 + Helpdesk Phase 3) ---
model Ticket {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject      String
  message      String
  status       TicketStatus    @default(OPEN)
  priority     TicketPriority  @default(MEDIUM)
  assignedToId String?
  assignedTo   User?           @relation("TicketAssignee", fields: [assignedToId], references: [id])
  reply        String?
  closedAt     DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  @@index([status])
  @@index([assignedToId])
  @@index([priority])
}

// --- CMS: Post (blog + trang tĩnh) Phase 3 ---
model Post {
  id             String       @id @default(cuid())
  type           PostType     @default(BLOG)
  title          String
  slug           String       @unique
  excerpt        String?
  content        String       // Markdown (đã chốt)
  coverImage     String?
  status         PostStatus   @default(DRAFT)
  categoryId     String?
  category       Category?   @relation(fields: [categoryId], references: [id])
  authorId       String
  author         User         @relation(fields: [authorId], references: [id])
  seoTitle       String?
  seoDescription String?
  viewCount      Int          @default(0)
  publishedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  @@index([type, status, publishedAt])
}

// =================== PHASE 4 — MODULE DỊCH VỤ CUSTOM ===================

// Trạng thái dự án custom (Kanban pipeline)
enum ProjectStatus {
  NEW         // yêu cầu mới tiếp nhận
  QUOTING     // đang báo giá
  CONFIRMED   // khách đã chốt & ký scope
  IN_PROGRESS // đang phát triển
  REVIEW      // chờ khách review
  DELIVERED   // đã bàn giao
  WARRANTY    // đang bảo hành
  CANCELLED   // hủy (đóng board)
}

// Loại dự án custom (phân loại yêu cầu)
enum ProjectType {
  WEB_APP
  MOBILE_APP
  DESKTOP_APP
  EXTENSION
  INTEGRATION
  OTHER
}

// Loại file trong dự án
enum ProjectFileKind {
  REQUEST_ATTACHMENT // file khách gửi lúc yêu cầu
  DELIVERABLE        // file bàn giao (có version)
  MESSAGE_ATTACHMENT // file đính kèm trong chat
}

// Trạng thái milestone thanh toán
enum MilestoneStatus {
  PENDING   // chưa đến hạn/đợi
  INVOICED  // đã xuất link chờ thu
  PAID      // đã thu tiền
  SKIPPED   // bỏ qua
}

// 1) Yêu cầu báo giá từ khách (form public, không cần login)
model CustomProjectRequest {
  id          String       @id @default(cuid())
  userId      String?      // nullable: khách vãng lai chưa login vẫn gửi được
  user        User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        ProjectType  // loại dự án
  title       String       // tiêu đề yêu cầu
  description String       // mô tả chi tiết nhu cầu
  budget      Int?         // ngân sách dự kiến VND, nullable nếu "thỏa thuận"
  deadline    DateTime?    // hạn mong muốn bàn giao
  contactName String?      // tên liên hệ (khách vãng lai)
  contactEmail String?     // email liên hệ (khách vãng lai)
  status      ProjectStatus @default(NEW)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  project     CustomProject? // 1 request -> 0..1 project (kế thừa khi tiếp nhận)
  @@index([userId])
  @@index([status])
  @@index([type])
}

// 2) Dự án custom đã tiếp nhận (Kanban)
model CustomProject {
  id              String       @id @default(cuid())
  requestId       String       @unique // liên kết 1-1 với request gốc
  request         CustomProjectRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  userId          String       // khách hàng (snap từ request để query nhanh)
  user            User         @relation("CustomerProject", fields: [userId], references: [id], onDelete: Cascade)
  assigneeId      String?      // nhân viên phụ trách (STAFF/ADMIN)
  assignee        User?        @relation("ProjectAssignee", fields: [assigneeId], references: [id])
  title           String
  description      String?
  status          ProjectStatus @default(NEW)
  quotedAmount     Int?         // tổng giá báo (VND)
  contractKey      String?      // key hợp đồng PDF trên R2 (nếu có)
  contractSignedAt DateTime?    // thời điểm khách xác nhận scope
  priority         TicketPriority @default(MEDIUM) // ưu tiên (tái dùng enum TicketPriority)
  warrantyMonths   Int          @default(3) // thời hạn bảo hành (tháng) — chốt 3
  warrantyEndAt    DateTime?    // ngày kết thúc bảo hành (tính từ DELIVERED)
  isShowcase       Boolean      @default(false) // hiện trên /du-an (portfolio)
  slug             String?      @unique // slug cho portfolio detail
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  milestones       Milestone[]
  messages         ProjectMessage[]
  files            ProjectFile[]
  @@index([status])
  @@index([assigneeId])
  @@index([userId])
  @@index([slug])
}

// 3) Milestone thanh toán theo giai đoạn
model Milestone {
  id          String          @id @default(cuid())
  projectId   String
  project     CustomProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String          // tên giai đoạn (VD: Đặt cọc 30%)
  description String?
  amount      Int             // số tiền VND
  percent     Int?            // tỷ lệ % (validate tổng = 100)
  dueDate     DateTime?       // hạn thanh toán
  status      MilestoneStatus @default(PENDING)
  paidAt      DateTime?       // thời điểm thu tiền
  sortOrder   Int             @default(0) // thứ tự milestone
  paymentId   String?         @unique
  payment     Payment?        @relation(fields: [paymentId], references: [id])
  createdAt   DateTime        @default(now())
  @@index([projectId])
  @@index([status])
}

// 4) Trao đổi khách <-> admin
model ProjectMessage {
  id        String        @id @default(cuid())
  projectId String
  project   CustomProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  senderId  String        // người gửi (khách hoặc STAFF/ADMIN)
  sender    User          @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content   String        // nội dung tin nhắn
  isFromStaff Boolean     @default(false) // true nếu do nhân viên gửi
  createdAt DateTime      @default(now())
  @@index([projectId, createdAt])
  @@index([senderId])
}

// 5) File đính kèm / deliverable có versioning
model ProjectFile {
  id         String          @id @default(cuid())
  projectId  String
  project    CustomProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploaderId String          // người upload
  uploader   User            @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  kind       ProjectFileKind // loại file
  name       String          // tên hiển thị
  fileKey    String          // key trên R2 (S3-compatible)
  version    Int             @default(1) // version (cho deliverable)
  size       Int?            // kích thước bytes
  mimeType   String?         // content-type
  createdAt  DateTime        @default(now())
  @@index([projectId, kind])
  @@index([uploaderId])
}

// Thanh toán (tạo riêng, tái dùng webhook Phase 1; không phá Order)
model Payment {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id])
  provider    PaymentProvider
  providerRef String?         // orderCode PayOS (webhook lookup)
  amount      Int
  status      String          @default("PENDING")
  orderId     String?         // thanh toán Order (Phase 1)
  milestoneId String?         @unique // thanh toán Milestone (Phase 4)
  milestone   Milestone?      // back-relation (FK nằm ở Milestone.paymentId)
  projectId   String?         // denormalized để query công nợ nhanh
  createdAt   DateTime        @default(now())
  @@unique([provider, providerRef])
  @@index([orderId])
  @@index([milestoneId])
  @@index([projectId])
}

// Audit Log (Phase 5 - M4): ghi nhận hành động nhạy cảm để truy vết
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  // null nếu hành động trước khi login (vd LOGIN_FAIL)
  action    String   // LOGIN_SUCCESS, LOGIN_FAIL, LICENSE_DOWNLOAD, ORDER_PAID, PROJECT_STATUS_CHANGE, MILESTONE_PAID
  entity    String?  // 'User' | 'License' | 'Order' | 'CustomProject' | 'Milestone'
  entityId  String?
  ip        String?
  meta      Json?    // { email, productId, oldStatus, newStatus, amount... }
  createdAt DateTime @default(now())

  @@index([action, createdAt])
  @@index([userId, createdAt])
}
