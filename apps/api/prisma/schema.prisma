generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentProvider {
  PAYOS
  STRIPE
}

enum CouponType {
  PERCENT
  FIXED
}

enum TicketStatus {
  OPEN
  REPLIED
  CLOSED
}

enum ReviewStatus {
  PENDING
  APPROVED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  role         Role     @default(CUSTOMER)
  emailVerifiedAt DateTime?
  image        String?
  resetToken   String?
  resetExpires DateTime?
  verificationToken   String?
  verificationExpires DateTime?
  createdAt    DateTime @default(now())
  orders       Order[]
  licenses     License[]
  reviews      Review[]
  tickets      Ticket[]
}

model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  products  Product[]
}

model Product {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  description String
  price       Int       // đơn vị VND (không dùng số thập phân)
  thumbnail   String?
  fileKey     String?   // key trên R2
  images      String[]  @default([]) // gallery (Phase 2)
  docs        Json?                     // tài liệu: [{title,url}]
  changelog   Json?                     // changelog: [{version,date,notes}]
  demoUrl     String?                   // link demo
  language    String?                   // ngôn ngữ (filter search Phase 2)
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id])
  isPublished Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  orderItems  OrderItem[]
  tiers       LicenseTier[]
  licenses    License[]
  reviews     Review[]
}

model Order {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id])
  status    OrderStatus    @default(PENDING)
  total     Int
  provider  PaymentProvider
  providerRef String?      // order code từ cổng TT
  items     OrderItem[]
  licenses  License[]      // 1 đơn có nhiều license (1/item, Phase 2)
  couponCode String?       // mã giảm giá áp dụng (Phase 2)
  createdAt DateTime       @default(now())
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  price         Int
  qty           Int     @default(1)
  licenseTierId String?  // gói license đã chọn (Phase 2)
  tierName      String?  // snapshot tên gói tại thời điểm mua
}

model License {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  orderId   String   // quan hệ cha (1 đơn có nhiều license)
  order     Order    @relation(fields: [orderId], references: [id])
  orderItemId String @unique // 1 license / 1 item (Phase 2; breaking từ orderId @unique)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  licenseTierId String?      // gói license (Phase 2)
  tier      LicenseTier? @relation(fields: [licenseTierId], references: [id])
  key       String   @unique
  downloadCount  Int  @default(0)
  downloadLimit  Int  @default(5)  // giới hạn tải (Phase 2)
  downloadResetAt DateTime @default(now()) // mốc reset định kỳ 1 tháng
  createdAt DateTime @default(now())
}

// --- Review & Rating (2.3) ---
model Review {
  id        String       @id @default(cuid())
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int          // 1-5
  comment   String?
  status    ReviewStatus @default(PENDING) // chờ admin duyệt
  createdAt DateTime     @default(now())
  @@unique([productId, userId])   // 1 user 1 review/sản phẩm
  @@index([productId])
  @@index([status])
}

// --- Multi-license (2.6) ---
model LicenseTier {
  id          String  @id @default(cuid())
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  licenses    License[]         // các license đã mua gói này
  name        String            // "Regular" | "Extended"
  slug        String            // unique trong product
  price       Int               // VND, server-authoritative
  description String?
  features    String[]          // quyền lợi gói
  sortOrder   Int     @default(0)
  createdAt   DateTime @default(now())
  @@unique([productId, slug])
}

// --- Coupon (2.5) ---
model Coupon {
  id          String      @id @default(cuid())
  code        String      @unique
  type        CouponType
  value       Int         // % (0-100) hoặc VND
  minOrder    Int?        // điều kiện tối thiểu
  maxDiscount Int?        // trần giảm cho PERCENT
  expiresAt   DateTime?
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
}

// --- Support Ticket (2.4) ---
model Ticket {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  message   String
  status    TicketStatus @default(OPEN)
  reply     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}
