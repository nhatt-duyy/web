# ============================================================================
# .env.production.example — MẪU env cho production
# Copy thành .env.production TRÊN VPS (KHÔNG commit file thật).
# Tất cả secret để placeholder — user tự điền giá trị thật.
# Sử dụng cùng docker-compose.prod.yml qua --env-file .env.production
# ============================================================================

# ---- Database ----
POSTGRES_USER=sourceban
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=sourceban
DATABASE_URL=postgresql://sourceban:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/sourceban?schema=public

# ---- Web (Next.js) ----
NODE_ENV=production
NEXTAUTH_URL=https://your-domain.com
WEB_URL=https://your-domain.com
ADMIN_URL=https://your-domain.com/admin
NEXT_PUBLIC_API_URL=https://your-domain.com/api
NEXTAUTH_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
SOURCE_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_BASE64_KEY

# ---- API (NestJS) ----
API_PORT=3001
JWT_SECRET=CHANGE_ME_JWT_SECRET
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ---- Payments (PayOS) ----
PAYOS_CLIENT_ID=CHANGE_ME
PAYOS_API_KEY=CHANGE_ME
PAYOS_CHECKSUM_KEY=CHANGE_ME

# ---- Email (Resend) ----
RESEND_API_KEY=CHANGE_ME

# ---- Storage (Cloudflare R2) ----
R2_ACCOUNT_ID=CHANGE_ME
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME
R2_BUCKET=sourceban-files

# ---- Search (MeiliSearch) ----
MEILI_HOST=http://meilisearch:7700
MEILI_MASTER_KEY=CHANGE_ME_MEILI_MASTER_KEY
