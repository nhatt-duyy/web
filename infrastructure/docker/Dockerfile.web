# ============================================================================
# Dockerfile.web — Next.js 16 (apps/web) — multi-stage, non-root, healthcheck
# Build context: root của monorepo
# Lưu ý: Next.js cần standalone output để image nhẹ. Bật trong next.config.
# ============================================================================

# ---- Stage 1: deps ----
FROM node:20-alpine AS base
RUN corepack enable
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
WORKDIR /app

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* ./
COPY turbo.json* ./ 2>/dev/null || true
COPY apps/web/package.json ./apps/web/package.json
COPY packages/ ./packages/

RUN --mount=type=cache,id=pnpm-web,target=/pnpm/store \
    pnpm install --frozen-lockfile || pnpm install

# ---- Stage 2: build ----
FROM base AS builder
WORKDIR /app
COPY apps/web ./apps/web
COPY packages ./packages
# Biến build-time (placeholder; override khi build production)
ARG NEXT_PUBLIC_API_URL=http://localhost:3001
ARG NEXTAUTH_URL=http://localhost:3000
ARG NEXT_PUBLIC_SENTRY_DSN=""
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXTAUTH_URL=$NEXTAUTH_URL
ENV NEXT_PUBLIC_SENTRY_DSN=$NEXT_PUBLIC_SENTRY_DSN
# NEXTAUTH_SECRET không dùng ở build, chỉ runtime
RUN pnpm --filter web build

# ---- Stage 3: runner ----
FROM node:20-alpine AS runner
RUN addgroup -S nodejs && adduser -S nextjs -G nodejs
WORKDIR /app
ENV NODE_ENV=production

# Next.js standalone output → copy từ .next/standalone
COPY --from=builder /app/apps/web/.next/standalone ./
COPY --from=builder /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder /app/apps/web/public ./apps/web/public 2>/dev/null || true

RUN chown -R nextjs:nodejs /app
USER nextjs

EXPOSE 3000

# Healthcheck: Next.js standalone phục vụ ở port 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget -qO- http://localhost:3000/ || exit 1

# Next standalone: server.js nằm ở root của standalone output
CMD ["node", "apps/web/server.js"]
