# ============================================================================
# Dockerfile.admin — React 19 SPA (apps/admin) — build tĩnh + nginx serve
# Build context: root của monorepo
# SPA sau khi vite build ra dist/ → nginx serve static, SPA fallback về index.html
# ============================================================================

# ---- Stage 1: build ----
FROM node:20-alpine AS builder
RUN corepack enable
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
WORKDIR /app

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* ./
COPY turbo.json* ./ 2>/dev/null || true
COPY apps/admin/package.json ./apps/admin/package.json
COPY packages/ ./packages/

RUN --mount=type=cache,id=pnpm-admin,target=/pnpm/store \
    pnpm install --frozen-lockfile || pnpm install

COPY apps/admin ./apps/admin
COPY packages ./packages

# Biến build-time cho API URL (admin gọi api qua proxy nginx hoặc trực tiếp)
ARG VITE_API_URL=/api
ARG VITE_SENTRY_DSN=""
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_SENTRY_DSN=$VITE_SENTRY_DSN
RUN pnpm --filter admin build

# ---- Stage 2: nginx serve ----
FROM nginx:1.27-alpine AS runner

# Cấu hình nginx: SPA fallback + gzip + security headers
COPY infrastructure/docker/nginx-admin.conf /etc/nginx/conf.d/default.conf

# Copy static build ra
COPY --from=builder /app/apps/admin/dist /usr/share/nginx/html

# nginx chạy mặc định là non-root (master root, worker nobody) trên alpine image
EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://localhost:80/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
